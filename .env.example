# 이 파일을 .env.local 로 복사해 값을 채운다.
# 이 파일은 git 에 커밋되므로 실제 값을 여기 적지 말 것 — 예시만 둔다.
# .env.local 은 커밋되지 않는다 (.gitignore).

# Supabase 프로젝트 URL — Project Settings > Data API
SUPABASE_URL=https://<project-ref>.supabase.co

# service_role 키 — Project Settings > API Keys
# ⚠️ RLS를 우회하는 관리자 키다. 서버에서만 쓰이며, NEXT_PUBLIC_ 접두어를 절대 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# /admin 로그인 비밀번호 (CSV 내려받기에도 ?key= 로 쓸 수 있다)
# 공개 주소에 올릴 때는 추측하기 어려운 값으로 정할 것.
ADMIN_PASSWORD=

# 수집 단계 — pilot | main
# 본실험으로 넘어갈 때 main 으로 바꾸고 재배포/재시작하면 된다.
# 파일럿 데이터를 지울 필요 없다. 조건 배정 카운터는 같은 단계 안에서만 세므로
# 본실험은 0명에서 다시 균형을 잡기 시작한다.
SURVEY_PHASE=pilot
